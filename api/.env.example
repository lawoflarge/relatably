# Relatably api/ — environment variables
#
# Copy to `api/.env.local` for local dev, and set the same keys in Vercel for prod.

# --- Firebase Admin (server) ---
FIREBASE_PROJECT_ID=                       # e.g. "relatably-prod"

# --- Firebase emulator (local dev / tests only — leave blank in prod) ---
FIRESTORE_EMULATOR_HOST=                   # e.g. "localhost:8080"
FIREBASE_AUTH_EMULATOR_HOST=               # e.g. "localhost:9099"

NODE_ENV=                                  # "development" | "test" | "production"

# Phase 5 — admin console
ADMIN_UIDS=                                # comma-separated Firebase Auth uids allowed to call /api/admin/*
NEXT_PUBLIC_ADMIN_UIDS=                    # same list, exposed to web client to gate /admin UI
NEXT_PUBLIC_FIREBASE_API_KEY=              # from `firebase apps:sdkconfig WEB --project relatably-prod`
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Sentry
SENTRY_DSN=                                # from Sentry → Project Settings → Client Keys (DSN)
SENTRY_ENVIRONMENT=production              # production | preview | development

# Cron — bearer token gating /api/cron/* endpoints. Must match the
# CRON_SECRET value set as a GitHub Actions repo secret (used by the
# .github/workflows/cron-*.yml workflows that POST every 5 minutes).
CRON_SECRET=

# Perspective API (tier-2 toxicity moderation, inline in POST /api/submit)
PERSPECTIVE_API_KEY=                       # https://developers.perspectiveapi.com (free tier: 1 QPS personal use)
