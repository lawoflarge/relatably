{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://relatably.vercel.app",
        "EXPO_PUBLIC_ADMOB_ENABLED": "false"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://relatably.vercel.app",
        "EXPO_PUBLIC_ADMOB_ENABLED": "false"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "levin.schwab@gmx.de",
        "appleTeamId": "R95M36AU2X"
      }
    }
  }
}
