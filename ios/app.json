{
  "expo": {
    "name": "Relatably",
    "slug": "relatably",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "relatably",
    "userInterfaceStyle": "light",
    "jsEngine": "jsc",
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.relatably.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "30"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-6563643868702361~4571132569"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Relatably uses this to show ads that are more relevant to you. If you decline, you'll still see ads, just less tailored."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "39e5ff5e-9f31-45a0-a7b3-79fccf010e54"
      }
    },
    "owner": "levinschwab"
  }
}
